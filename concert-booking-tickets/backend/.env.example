PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/concert_booking?replicaSet=rs0
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
SESSION_DAYS=7
HOLD_MINUTES=10
PAYMENT_PROVIDER=sandbox
# Generate independent random secrets of at least 32 characters.
TICKET_SECRET=replace-with-a-random-secret-at-least-32-characters
SANDBOX_SECRET=replace-with-another-random-secret-at-least-32-characters
# Required only for PAYMENT_PROVIDER=stripe. Use test keys for development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used only by npm run seed; no default administrator password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
